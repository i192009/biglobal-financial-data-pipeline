    {
      "id": 1,
      "title": "Executions processed and volume by currency (minor units)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "postgres",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT currency,sum(executions) AS executions,sum(trade_volume_minor) AS volume_minor,sum(fees_minor) AS fees_minor FROM analytics.mart_daily_trading_summary GROUP BY 1",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Awaiting data / run dbt build"
        },
        "overrides": []
      }
